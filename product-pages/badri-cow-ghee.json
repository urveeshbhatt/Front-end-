            {
              "id": "b8e6da6d",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "\n<table style=\"width:100%;border-collapse:collapse;font-size:15px;font-family:Inter,sans-serif;\">\n<thead>\n<tr style=\"background:#1B3B2B;color:#fff;\">\n<th style=\"padding:12px 16px;text-align:left;font-family:Playfair Display,serif;font-weight:600;\">Size</th>\n<th style=\"padding:12px 16px;text-align:left;\">Best For</th>\n<th style=\"padding:12px 16px;text-align:left;\">Approx. Duration</th>\n<th style=\"padding:12px 16px;text-align:left;\">Price</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\"><strong>150 g</strong><br><span style=\"font-size:12px;color:#D4AF37;font-weight:600;letter-spacing:1px;text-transform:uppercase;\">Trial Pack</span></td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">First-time buyers. Try before committing.</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">~2 weeks (single person)</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">[ADD PRICE]</td>\n</tr>\n<tr style=\"background:#F2F5F2;\">\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\"><strong>500 g</strong><br><span style=\"font-size:12px;color:#D4AF37;font-weight:600;letter-spacing:1px;text-transform:uppercase;\">Most Popular</span></td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">Couples &amp; small families.</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">~6 weeks (2 people)</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">[ADD PRICE]</td>\n</tr>\n<tr>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\"><strong>1 kg</strong><br><span style=\"font-size:12px;color:#D4AF37;font-weight:600;letter-spacing:1px;text-transform:uppercase;\">Best Value</span></td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">Families of 3–5. Daily cooking use.</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">~3 months (4 people)</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">[ADD PRICE]</td>\n</tr>\n<tr style=\"background:#F2F5F2;\">\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\"><strong>5 kg</strong><br><span style=\"font-size:12px;color:#D4AF37;font-weight:600;letter-spacing:1px;text-transform:uppercase;\">Bulk / Gifting</span></td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">Large families, bulk buyers, gifting &amp; corporate orders.</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">~15 months (4 people)</td>\n<td style=\"padding:12px 16px;border:1px solid #DDE5DD;\">[ADD PRICE]</td>\n</tr>\n</tbody>\n</table>\n<p style=\"font-size:13px;color:#888;margin-top:10px;font-family:Inter,sans-serif;\">All prices inclusive of GST. Free shipping above ₹[THRESHOLD].</p>\n",
