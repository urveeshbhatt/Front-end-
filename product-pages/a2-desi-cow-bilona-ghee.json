      "elements": [{"id":"f9d41fbd","elType":"column","settings":{"_column_size":100},"elements":[
        {"id":"cce71c36","elType":"widget","widgetType":"heading","settings":{"title":"Frequently Asked Questions","header_size":"h2","align":"center","title_color":"#2c1810","typography_typography":"custom","typography_font_size":{"unit":"px","size":28,"sizes":[]}}},
        {"id":"57d27a3e","elType":"widget","widgetType":"spacer","settings":{"space":{"unit":"px","size":24,"sizes":[]}}},
        {"id":"9097e00b","elType":"widget","widgetType":"accordion","settings":{"tabs":[{"tab_title":"What is the bilona method?","tab_content":"Bilona is a traditional Vedic process: A2 cows are milked, the milk is curdled, then hand-churned using a wooden mathani rotated with a hemp rope — no machine, no heat. The butter (makkhan) that rises is slow-cooked on a wood fire to get pure ghee. This is the exact process we use.","_id":"660a467f"},{"tab_title":"What makes A2 ghee different from regular ghee?","tab_content":"Regular commercial ghee can come from A1 milk (cross-bred cows). A2 ghee comes from indigenous desi cows whose milk contains the A2 beta-casein protein, which is easier to digest. Combined with the bilona method, A2 bilona ghee retains more nutrients than machine-made ghee.","_id":"110a9c4e"},{"tab_title":"Is this ghee A1 or A2?","tab_content":"[FILL IN: Confirm A2 from indigenous desi cows.]","_id":"1dae70fc"},{"tab_title":"What is the shelf life?","tab_content":"[FILL IN: 12–18 months from manufacture date if stored in a cool, dry place. Add exact date from your lab report.]","_id":"1ce971b1"},{"tab_title":"How should I store it?","tab_content":"Store in a cool, dry place away from direct sunlight. Do not refrigerate — ghee is shelf-stable. Always use a dry spoon.","_id":"c71048b0"},{"tab_title":"Does the ghee become solid in winter?","tab_content":"Yes — completely natural and a sign of purity. Solid in cold weather, liquid in warm. Both are fine to consume.","_id":"1723525b"},{"tab_title":"Can I return the product?","tab_content":"Returns accepted only for damaged or incorrect items within 48 hours of delivery. See our Return & Refund Policy.","_id":"beb5d916"},{"tab_title":"Do you ship pan-India?","tab_content":"Yes. Delivery takes 3–7 business days depending on location. See our Shipping Policy for zone-wise timelines.","_id":"3d0a00b1"}],"active_item":1,"title_color":"#2c1810","tab_active_color":"#a07850","border_color":"#e0d5c8","border_width":"1","icon_align":"right"}}
      ]}]
