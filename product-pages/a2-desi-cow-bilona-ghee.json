            {
              "id": "092f00f5",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "\n<p><strong>Bilona</strong> is a 3,000-year-old Vedic process that requires no machinery and no shortcuts.</p>\n<p>Here is how every jar of Burans Valley A2 Bilona Ghee is made:</p>\n<ol style=\"line-height:2;padding-left:20px;font-family:Inter,sans-serif;\">\n<li>A2 milk is collected from our desi cows in Uttarakhand.</li>\n<li>The milk is gently cultured overnight to make curd.</li>\n<li>The curd is hand-churned with a wooden <em>mathani</em> using a hemp rope — no electricity, no motors.</li>\n<li>The <em>makkhan</em> (white butter) that rises is separated.</li>\n<li>The makkhan is slow-cooked over a wood fire until pure golden ghee forms.</li>\n</ol>\n<p>[ADD: a founder note or sourcing detail about your specific farm / Uttarakhand location here.]</p>\n",
                "typography_typography": "custom",
                "typography_font_family": "Inter",
                "typography_font_size": {
                  "unit": "px",
                  "size": 16,
                  "sizes": []
                },
                "typography_line_height": {
                  "unit": "em",
                  "size": 1.85,
                  "sizes": []
                }
              }
            }
